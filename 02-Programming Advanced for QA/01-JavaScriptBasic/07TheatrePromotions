function ticketPrice(dayTipe, age){
    let ticketPrice;
    if (age < 0 || age > 122) {
        console.log("Error!")
        return;
    }
    if (age >= 0 && age <= 18){
        if (dayTipe === "Weekday") {
            ticketPrice = 12.00;
        } else if (dayTipe === "Weekend") {
            ticketPrice = 15.00;
        } else if (dayTipe === "Holiday") {
            ticketPrice = 5.00;
        }
    } else if (age > 18 && age <= 64) {
        if (dayTipe === "Weekday") {
            ticketPrice = 18.00;
        } else if (dayTipe === "Weekend") {
            ticketPrice = 20.00;
        } else if (dayTipe === "Holiday") {
            ticketPrice = 12.00;
        }
    } else if (age > 64 && age <= 122){
        if (dayTipe === "Weekday") {
            ticketPrice = 12.00;
        } else if (dayTipe === "Weekend") {
            ticketPrice = 15.00;
        } else if (dayTipe === "Holiday") {
            ticketPrice = 10.00;
        }
    }
    console.log(`${ticketPrice}$`)
}

