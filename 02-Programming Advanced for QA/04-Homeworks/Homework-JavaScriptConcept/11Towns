function towns(info) {
    for (let row of info) {
        let [town, lat, lng] = row.split(' | ');
        let townObj = {
            town: town,
            latitude: Number(lat).toFixed(2),
            longitude: Number(lng).toFixed(2)
        };
        console.log(townObj);
    }
}

