function employees(info) {
    let employeeInfo = {};

    for (let name of info) {
        employeeInfo[name] = name.length;
    }
    for (let name in employeeInfo) {
        console.log(`Name: ${name} -- Personal Number: ${employeeInfo[name]}`)
    }
}

