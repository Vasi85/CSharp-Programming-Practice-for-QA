function ages(array){
    let number = array[0];
    let age = " ";
    if (number >= 0 && number <= 2) {
        age = "baby";
    } else if (number >= 3 && number <= 13) {
        age = "child";
    } else if (number >= 14 && number <= 19) {
        age = "teenager";
    } else if (number >= 20 && number <= 65) {
        age = "adult";
    } else if (number >= 66) {
        age = "elder"
    } else {
        age = "out of bounds"
    }
    console.log(age)
}

ages(-1)