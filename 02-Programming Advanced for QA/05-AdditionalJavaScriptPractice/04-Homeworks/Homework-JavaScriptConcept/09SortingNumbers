function sort(array) {
    let sorted = array.slice().sort((a, b) => a - b);
    let result = [];

    while (sorted.length) {
        result.push(sorted.shift())

        if(sorted.length) {
            result.push(sorted.pop());
        }
    }
    result.forEach(num => console.log(num));
}

sort([1, 65, 3, 52, 48, 63, 31, -3, 18, 56]);